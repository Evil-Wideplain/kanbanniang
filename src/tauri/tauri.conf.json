{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KanbanNiang",
  "version": "0.1.0",
  "identifier": "com.example.kanbanmascot",
  "build": {
    "frontendDist": "../../dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "看板娘",
        "width": 640,
        "height": 800,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "center": true
      },
      {
        "label": "settings",
        "title": "看板娘 · 设置",
        "url": "settings.html",
        "width": 440,
        "height": 760,
        "resizable": false,
        "visible": false,
        "alwaysOnTop": true,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
